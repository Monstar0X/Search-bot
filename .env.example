# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
OWNER_TELEGRAM_ID=your_telegram_user_id_here

# Webhook Configuration (for deployment platforms like Leapcell)
WEBHOOK_URL=https://your-app-url.leapcell.dev
PORT=3000

# Database
DATABASE_PATH=./data/channels.db

# Sync Configuration
SYNC_INTERVAL_HOURS=24
QUICK_SYNC_INTERVAL_HOURS=6

# Bot Settings
MAX_SEARCH_RESULTS=5
SEARCH_HISTORY_ENABLED=true

# Optional: Customization
BOT_NAME=Swordsmith Channel Search
WELCOME_MESSAGE_CUSTOM=true

# Logging
LOG_LEVEL=info
LOG_DIR=./logs