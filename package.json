{
  "name": "swordsmith-channel-search-bot",
  "version": "1.0.0",
  "description": "Telegram bot for searching through owned anime and swordsmithing channels",
  "main": "app-mongodb.js",
  "scripts": {
    "build": "tsc",
    "start": "node app-mongodb.js",
    "start:mongodb": "node app-mongodb.js",
    "start:simple": "node app-fixed.js",
    "start:bot": "node dist/bot.js",
    "start:server": "node dist/server.js",
    "start:webhook": "node dist/bot-webhook.js",
    "dev": "nodemon app.js",
    "dev:bot": "nodemon --exec ts-node bot.ts",
    "dev:server": "nodemon --exec ts-node server.ts",
    "dev:webhook": "nodemon --exec ts-node bot-webhook.ts",
    "lint": "eslint src/**/*.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "telegram",
    "bot",
    "channels",
    "search",
    "anime",
    "swordsmith"
  ],
  "author": "Swordsmith Community",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongodb": "^6.20.0",
    "node-telegram-bot-api": "^0.64.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.8.7",
    "@types/node-telegram-bot-api": "^0.64.3",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
